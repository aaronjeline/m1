namespace Examples.Cedar.NoPanic
open M1

/-- A sub-range of an `Outside` range. -/
theorem Outside.sub {lo sp a : BitVec 64} {k : Nat} (h : Outside lo sp a k) (c j : Nat) (hc : c + j ≤ k) :
    Outside lo sp (a + BitVec.ofNat 64 c) j := by
  intro i hi
  have := h (c + i) (by omega)
  rwa [BitVec.ofNat_add, ← BitVec.add_assoc] at this

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1

/-- A callee entered at the frame base has the stack room the caller had beyond its frame. -/
theorem Frame.callRoom {L : Layout} {lo top out : BitVec 64} {n : Nat} {s0 s : State} (h : Frame L lo top out n s0 s)
    {k : Nat} (hk : L.size + k ≤ (s0.sp - lo).toNat) : Room lo top k s := by
  have hlt := h.size_lt
  have e : s.sp - lo = (s0.sp - lo) - BitVec.ofNat 64 L.size := by
    rw [h.sp, Layout.base]
    have : BitVec.ofNat 64 (2 ^ 64 - L.size) = 0#64 - BitVec.ofNat 64 L.size := by
      apply BitVec.eq_of_toNat_eq
      simp only [BitVec.toNat_ofNat, BitVec.toNat_sub]
      by_cases h0 : L.size = 0
      · simp [h0]
      · rw [Nat.mod_eq_of_lt (a := L.size) (by omega)]; omega
    rw [this]; bv_omega
  have hs : (s.sp - lo).toNat = (s0.sp - lo).toNat - L.size := by
    rw [e, BitVec.toNat_sub_of_le] <;> simp only [BitVec.toNat_ofNat, BitVec.le_def] <;>
      rw [Nat.mod_eq_of_lt (by omega)] <;> omega
  have := h.room'
  exact ⟨by omega, by omega⟩

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

/-- A callee's `OnlyWrites` (entered at `sp`), as a `MemW` that allows the free
stack below any `sp0` above `sp` and the callee's destination. -/
theorem OnlyWrites.memW {lo dst sp0 : BitVec 64} {k : Nat} {s s' : State} (h : OnlyWrites lo dst k s s')
    (hsp : (s.sp - lo).toNat ≤ (sp0 - lo).toNat) :
    MemW (fun x => FreeStack lo sp0 x ∨ (x - dst).toNat < k) s.mem s'.mem := by
  intro x hx
  by_cases h1 : FreeStack lo s.sp x
  · exact Or.inl (by unfold FreeStack at *; omega)
  · by_cases h2 : k ≤ (x - dst).toNat
    · exact absurd (h x h1 h2) hx
    · exact Or.inr (by omega)

/-- Frame bytes are in the free stack below the entry `SP`. -/
theorem frame_freeStack {L : Layout} {lo top : BitVec 64} {s0 : State} (room : L.size ≤ (s0.sp - lo).toNat)
    (room' : (s0.sp - lo).toNat ≤ (top - lo).toNat) {x : BitVec 64}
    (hx : (x - L.base s0.sp).toNat < L.size) : FreeStack lo s0.sp x :=
  (frame_onStack room room' hx).2

/-- `OnlyWrites` from a `MemW` over the free stack and the destination. -/
theorem OnlyWrites.of_memW {lo dst : BitVec 64} {k : Nat} {s s' : State}
    (h : MemW (fun x => FreeStack lo s.sp x ∨ (x - dst).toNat < k) s.mem s'.mem) : OnlyWrites lo dst k s s' :=
  fun x h1 h2 => Classical.byContradiction fun hc => by
    rcases h x hc with h3 | h3
    · exact h1 h3
    · omega

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

/-- State the goal's postcondition relative to the goal's (current) state, e.g.
to run a prologue that starts after a few instructions. -/
theorem SafeN.withEntry {p : Program} {B : BitVec 64 → Prop} {n : Nat} {st : State} {R : State → Prop}
    (Q : State → State → Prop) (h : SafeN p B n st (Q st)) (hq : ∀ s', Q st s' → R s') : SafeN p B n st R :=
  h.mono hq

/-- `NPPost` relative to a state that agrees with the entry state on what
`NPPost` looks at. -/
theorem NPPost.rebase {top out : BitVec 64} {k : Nat} {post post' : State → State → Prop} {s0 s0' s' : State}
    (h : NPPost top out k post s0' s') (hsp : s0'.sp = s0.sp)
    (hg : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → s0'.gpr r = s0.gpr r)
    (hv : s0'.vreg = s0.vreg) (hf : s0'.fpcr = s0.fpcr) (hm : s0'.mem = s0.mem)
    (hpost : post s0' s' → post' s0 s') : NPPost top out k post' s0 s' := by
  obtain ⟨h1, h2, ⟨hg', hsp', hv', hf'⟩, hk, htl, hp⟩ := h
  refine ⟨by rw [h1]; exact hg 30 (by decide) (by decide), h2,
    ⟨fun r a b => by rw [hg' r a b, hg r a (by omega)], by rw [hsp', hsp],
      fun r a b => by rw [hv' r a b, hv], by rw [hf', hf]⟩, ?_, by rw [htl, hm], hpost hp⟩
  intro a h1 h2
  rw [← hm]; exact hk a (by rw [hsp]; exact h1) h2

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1

/-- At a call to a callee with contract `c` (an `NP` contract at the current
index, with no output in our frame), from `F : Frame L ..` of the state before
the call's argument setup: the callee's precondition is the first goal (its
`SP` alignment is discharged), then the continuation from the return state
`s2` with `F2 : Frame L .. s2`, `hcs : CalleeSaved _ s2` and the callee's
postcondition `hpost`. -/
macro "frame_call" F:term:max L:ident c:term:max "as" s2:ident F2:ident hcs:ident hpost:ident : tactic =>
  `(tactic| (refine SafeFun.call $c rfl rfl ⟨by m1_simp_step, ?_⟩ ?_
             rotate_left
             rintro $s2 h2pc_ h2st_ ⟨$hcs, hk_, htl_, $hpost⟩
             have $F2 := Frame.call (by frame_update $F $L; frame_mem) $hcs hk_ htl_
               (fun _ h => absurd h (Nat.not_lt_zero _))
             simp only [M1.upd, BitVec.reduceEq, ite_true, ite_false] at h2pc_
             clear hk_ htl_
             rotate_right))

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

/-- `OnlyWrites` with no destination, as a `MemW` over the free stack below `sp0`
(above the callee's `SP`) and anything else. -/
theorem OnlyWrites.memW0 {lo sp0 : BitVec 64} {s s' : State} (h : OnlyWrites lo 0#64 0 s s')
    (hsp : (s.sp - lo).toNat ≤ (sp0 - lo).toNat) (Q : BitVec 64 → Prop) :
    MemW (fun x => FreeStack lo sp0 x ∨ Q x) s.mem s'.mem :=
  (h.memW hsp).mono fun _ hx => hx.imp id fun h => absurd h (Nat.not_lt_zero _)

end Examples.Cedar.NoPanic

/-! ### Leaf functions without a frame and without stores -/

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

/-- Nothing a caller can see has changed (a leaf that uses only `x0`–`x18` and
stores nothing). -/
def LeafInv (s0 s : State) : Prop :=
  s.status = .running ∧ s.sp = s0.sp ∧ (∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → s.gpr r = s0.gpr r) ∧
    s.vreg = s0.vreg ∧ s.fpcr = s0.fpcr ∧ s.mem = s0.mem

/-- **Whole-function invariant for a leaf**: if from every state at one of the
function's PCs (`pcs`) satisfying `LeafInv`, one step is good and gets to
`LeafInv` at one of `pcs`, or returns (`PC = x30` with `LeafInv`), the
function satisfies `NP` with no output (loops need no further invariant). -/
theorem leaf_np {p : Program} {top entry : BitVec 64} {pre : State → Prop} (pcs : List (BitVec 64))
    (hentry : entry ∈ pcs)
    (hstep : ∀ s0 s, pre s0 → LeafInv s0 s → s.pc ∈ pcs →
      ¬ Panic s.pc ∧ ((LeafInv s0 (step p s) ∧ (step p s).pc ∈ pcs) ∨
        ((step p s).pc = s0.gpr 30 ∧ LeafInv s0 (step p s)))) :
    NP p top entry pre (fun _ => 0#64) 0 (fun _ _ => True) := by
  intro n s0 hpc hst ⟨_, hpre⟩
  refine SafeN.loop (fun s => LeafInv s0 s ∧ s.pc ∈ pcs) (fun n s ⟨hi, hp⟩ => ?_) n s0
    ⟨⟨hst, rfl, fun _ _ _ => rfl, rfl, rfl, rfl⟩, hpc ▸ hentry⟩
  obtain ⟨hb, h⟩ := hstep s0 s hpre hi hp
  refine ⟨⟨hi.1, hb⟩, SafeN.done ?_⟩
  rcases h with h | ⟨h1, hst', hsp, hg, hv, hf, hm⟩
  · exact Or.inl h
  · refine Or.inr ⟨h1, hst', ⟨fun r a b => hg r a (by omega), hsp, fun r _ _ => by rw [hv], hf⟩,
      fun a _ _ => by rw [hm], by rw [hm], trivial⟩

end Examples.Cedar.NoPanic


namespace Examples.Cedar.NoPanic
open M1

/-- Discharge `leaf_np`'s obligation (after `refine leaf_np pcs (by decide) ?_`):
one symbolic step from each PC, both successors of a branch. -/
macro "leaf_auto" pcs:ident : tactic =>
  `(tactic| (intro s0 s _ ⟨hst, hsp, hg, hv, hf, hm⟩ hpc
             simp only [$pcs:ident, List.mem_cons, List.mem_nil_iff, or_false] at hpc
             split_ors hpc
             all_goals refine ⟨by simp only [Panic, hpc]; decide, ?_⟩
             all_goals m1_rw_extends
             all_goals m1_simp_step
             all_goals repeat' split
             all_goals first
               | (left; refine ⟨⟨rfl, rfl, fun r h1 h2 => ?_, rfl, rfl, rfl⟩, by first | decide | (dsimp only; decide)⟩
                  first | exact hg r h1 h2 | (simp (disch := bv_omega) only [upd_other]; exact hg r h1 h2))
               | (right; refine ⟨rfl, rfl, fun r h1 h2 => ?_, rfl, rfl, rfl⟩
                  first | exact hg r h1 h2 | (simp (disch := bv_omega) only [upd_other]; exact hg r h1 h2))))

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

/-- **Frameless code up to an exit PC** (e.g. before a shrink-wrapped
prologue): as `leaf_np`, but the run ends at `exit` (the obligation has the
same shape, so `leaf_auto` discharges it). -/
theorem leaf_to {p : Program} {n : Nat} {s0 : State} (pcs : List (BitVec 64)) (exit : BitVec 64)
    (hpc : s0.pc ∈ pcs) (hst : s0.status = .running)
    (hstep : ∀ s0 s, True → LeafInv s0 s → s.pc ∈ pcs →
      ¬ Panic s.pc ∧ ((LeafInv s0 (step p s) ∧ (step p s).pc ∈ pcs) ∨
        ((step p s).pc = exit ∧ LeafInv s0 (step p s)))) :
    SafeN p Panic n s0 (fun s => s.pc = exit ∧ LeafInv s0 s) := by
  refine SafeN.loop (fun s => LeafInv s0 s ∧ s.pc ∈ pcs) (fun n s ⟨hi, hp⟩ => ?_) n s0
    ⟨⟨hst, rfl, fun _ _ _ => rfl, rfl, rfl, rfl⟩, hpc⟩
  obtain ⟨hb, h⟩ := hstep s0 s trivial hi hp
  exact ⟨⟨hi.1, hb⟩, SafeN.done h⟩

end Examples.Cedar.NoPanic

/-! ### Read-only functions with a frame: a whole-body invariant -/

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

/-- The body invariant of a function that stores nothing outside its frame
(and whose callees store nothing but in their own frames): the frame
invariant, memory changed only in the free stack below the entry `SP`. -/
def BodyInv (L : Layout) (lo top : BitVec 64) (s0 s : State) : Prop :=
  Frame L lo top 0#64 0 s0 s ∧ MemW (fun x => FreeStack lo s0.sp x ∨ (x - 0#64).toNat < 0) s0.mem s.mem ∧
    s.status = .running

/-- The postcondition of such a function: `NPPost` with only the free stack written. -/
abbrev ROPost (lo top : BitVec 64) (s0 s' : State) : Prop :=
  NPPost top 0#64 0 (fun s0 s' => OnlyWrites lo 0#64 0 s0 s') s0 s'

/-- **Whole-body invariant**: from every state at one of the body's PCs
satisfying `BodyInv`, the next step is good and execution gets back to the
body with `BodyInv` (possibly through a call), or returns. -/
theorem body_loop {L : Layout} {lo top : BitVec 64} {p : Program} {n : Nat} {s0 s1 : State}
    (body : List (BitVec 64)) (h1 : BodyInv L lo top s0 s1) (hpc : s1.pc ∈ body)
    (hstep : ∀ n s, BodyInv L lo top s0 s → s.pc ∈ body → ¬ Panic s.pc ∧
      SafeN p Panic n (step p s) (fun s' => (BodyInv L lo top s0 s' ∧ s'.pc ∈ body) ∨ ROPost lo top s0 s')) :
    SafeN p Panic n s1 (ROPost lo top s0) := by
  refine SafeN.loop (fun s => BodyInv L lo top s0 s ∧ s.pc ∈ body) (fun n s ⟨hi, hp⟩ => ?_) n s1 ⟨h1, hpc⟩
  obtain ⟨hb, h⟩ := hstep n s hi hp
  exact ⟨⟨hi.2.2, hb⟩, h⟩

/-- `BodyInv` survives a step that keeps the frame and writes nothing. -/
theorem BodyInv.of_frame {L : Layout} {lo top : BitVec 64} {s0 s s' : State} (h : BodyInv L lo top s0 s)
    (F : Frame L lo top 0#64 0 s0 s') (hm : s'.mem = s.mem) (hst : s'.status = .running) :
    BodyInv L lo top s0 s' := ⟨F, hm ▸ h.2.1, hst⟩

/-- `BodyInv` after a call whose contract writes only the callee's frame. -/
theorem BodyInv.call {L : Layout} {lo top : BitVec 64} {s0 s st s' : State} (h : BodyInv L lo top s0 s)
    (F : Frame L lo top 0#64 0 s0 s') (hw : OnlyWrites lo 0#64 0 st s') (hm : st.mem = s.mem)
    (hsp' : st.sp = s.sp) (hst : s'.status = .running) :
    BodyInv L lo top s0 s' := by
  refine ⟨F, h.2.1.trans (hm ▸ hw.memW0 (hsp' ▸ ?_) _), hst⟩
  have := h.1.top_sub_sp
  have hs := h.1.sp
  have hlt := h.1.size_lt
  have r1 := h.1.room; have r2 := h.1.room'
  have e : s.sp - lo = (s0.sp - lo) - BitVec.ofNat 64 L.size := by
    rw [hs, Layout.base]
    have : BitVec.ofNat 64 (2 ^ 64 - L.size) = 0#64 - BitVec.ofNat 64 L.size := by
      apply BitVec.eq_of_toNat_eq
      simp only [BitVec.toNat_ofNat, BitVec.toNat_sub]
      by_cases h0 : L.size = 0
      · simp [h0]
      · rw [Nat.mod_eq_of_lt (a := L.size) (by omega)]; omega
    rw [this]; bv_omega
  rw [e, BitVec.toNat_sub_of_le] <;> simp only [BitVec.toNat_ofNat, BitVec.le_def] <;>
    rw [Nat.mod_eq_of_lt (by omega)] <;> omega

/-- `ROPost` from the epilogue's `NPPost` (memory unchanged by the epilogue). -/
theorem ROPost.of_epi {lo top : BitVec 64} {s0 s s' : State} (h : BodyInv L lo top s0 s)
    (he : NPPost top 0#64 0 (fun _ s' => s'.mem = s.mem) s0 s') : ROPost lo top s0 s' := by
  obtain ⟨a, b, c, d, e, f⟩ := he
  exact ⟨a, b, c, d, e, OnlyWrites.of_memW (by show MemW _ s0.mem s'.mem; rw [f]; exact h.2.1)⟩

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1

/-- One case of `body_loop`'s obligation, after the state's PC is known
(`hpc`) and `hI : BodyInv L lo top s0 s`: one step, then back in the body
(PCs `body`), through an epilogue (`frame_epi`), or through a call to one
of the callees `cs` (`NP` contracts at the current index whose precondition is
`True` or stack room, and whose postcondition is, or starts with,
`OnlyWrites lo 0 0`). -/
macro "body_case" L:ident body:ident hI:ident hpc:ident cs:term,* : tactic =>
  `(tactic| (obtain ⟨F_, hmw_, hst_⟩ := id $hI
             have hsp_ := F_.sp; have hal_ := F_.al; frame_simp $L at hsp_
             refine ⟨by simp only [Panic, $hpc:ident]; decide, ?_⟩
             m1_rw_extends
             m1_simp_step
             repeat' split
             all_goals first
               | (apply SafeN.done; left
                  refine ⟨BodyInv.of_frame $hI ?_ rfl rfl, ?_⟩
                  · frame_update F_ $L
                    frame_mem
                  first | decide | (dsimp only; decide))
               | (first $[| refine SafeFun.call $cs (by dsimp only; decide) rfl ⟨by m1_simp_step, ?_⟩ ?_]*
                  · first
                    | exact True.intro
                    | (apply Frame.callRoom (L := $L) (out := 0#64) (n := 0)
                       · frame_update F_ $L; frame_mem
                       · simp only [$L:ident]; omega)
                  rintro s2_ h2pc_ h2st_ ⟨hcs_, hk_, htl_, hw_⟩
                  apply SafeN.done; left
                  refine ⟨?_, ?_⟩
                  · first
                      | refine BodyInv.call $hI (Frame.call ?_ hcs_ hk_ htl_ (fun _ h => absurd h (Nat.not_lt_zero _)))
                          hw_ rfl ?_ h2st_
                      | refine BodyInv.call $hI (Frame.call ?_ hcs_ hk_ htl_ (fun _ h => absurd h (Nat.not_lt_zero _)))
                          hw_.1 rfl ?_ h2st_
                    · frame_update F_ $L
                      frame_mem
                    · m1_simp_step
                  · simp only [M1.upd, BitVec.reduceEq, ite_true, ite_false] at h2pc_
                    rw [h2pc_]; first | decide | (dsimp only; decide))
               | (refine SafeN.mono (Q := ROPost _ _ _) ?_ fun _ h => Or.inr h
                  frame_upd F_ $L as F2_
                  · frame_mem
                  first
                    | (frame_epi F2_ $L
                       exact OnlyWrites.of_memW hmw_)
                    | (m1_run
                       frame_tail F2_ $L as hcs_t hh30_t hk_t htl_t
                       first $[| refine SafeFun.call $cs (by dsimp only; decide) rfl ⟨by m1_simp_step, ?_⟩ ?_]*
                       · first
                         | exact True.intro
                         | (constructor <;> (dsimp only; omega))
                       rintro s3_ h3pc_ h3st_ ⟨hcs3_, hk3_, htl3_, hw3_⟩
                       refine SafeN.done (tail_np hcs_t hh30_t hk_t htl_t h3pc_ h3st_ hcs3_ hk3_ htl3_ (Or.inl rfl) ?_)
                       first
                         | exact OnlyWrites.of_memW (hmw_.trans (hw3_.memW0 (Nat.le_refl _) _))
                         | exact OnlyWrites.of_memW (hmw_.trans (hw3_.1.memW0 (Nat.le_refl _) _))))))

end Examples.Cedar.NoPanic
