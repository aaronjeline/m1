import Examples.Cedar.NoPanic.Lemmas
import M1.SafeRun

/-!
# A generic stack-frame invariant

Almost every non-leaf function compiled by rustc/LLVM for arm64 has the same
shape:

```
stp x22, x21, [sp, #-0x30]!     ; or `sub sp, sp, #F` + `stp`s, `stp d9, d8, ...`
stp x20, x19, [sp, #0x10]
stp x29, x30, [sp, #0x20]
add x29, sp, #0x20
...                              ; body: locals in [sp, sp+F), calls with SP = sp
ldp x29, x30, [sp, #0x20]
ldp x20, x19, [sp, #0x10]
ldp x22, x21, [sp], #0x30
ret                              ; or `b callee` (a tail call)
```

A `Layout` records the frame size `F` and where each callee-saved register is
saved (offsets from the frame base `entry SP - F`). `Frame L lo top out n s0 s`
is the invariant that holds in the body (from the entry state `s0` to the
current state `s`): `SP` is the frame base, every saved register's slot holds
its entry value, every callee-saved register that is *not* saved still holds
its entry value, the caller's frames are unchanged except the declared output
`[out, out+n)` (`Keeps`), and the TLV descriptor is unchanged.

The lemmas:
* `Frame.intro` / `Entered.intro`: after the prologue;
* `Frame.update`: across code that changes only writable bytes (`Frame.W`:
  frame bytes that are not save slots, the declared output, memory off the
  stack other than the TLV descriptor) and registers other than the unsaved
  callee-saved ones (`Frame.wr_local`, `Frame.wr_out`, `Frame.wr_heap`,
  `MemW.write64'`, ... build the memory side condition);
* `Frame.call`: across a call whose contract gives `CalleeSaved` and `Keeps`
  (an `NPContract`), with the callee's output writable for us;
  `Frame.callRoom`: the stack room a callee gets;
* `Frame.ret` / `Frame.ret_np`: after the epilogue, the `NPContract` frame
  conditions (`CalleeSaved`, `Keeps`, TLV, `x30` the return address);
  `Frame.ret_goal` + `tail_np`: the same before a tail call, composed with the
  callee's contract.

Tactics (all on `SafeN` goals; `m1_run` / `m1_ite` are in `M1/SafeRun.lean`):
* `frame_enter L lo top out n pc as s1 E`: step the prologue (to `pc`) and
  continue from `s1` with `E : Entered ..` (frame, arguments, memory);
* `frame_upd F L as F'` / `frame_update F L`: move a `Frame` to the current
  record (memory side condition: `frame_mem`, `mem_range`);
* `frame_call F L c as s2 F2 hcs hpost`: a call with no output;
* `frame_epi F L` / `frame_ret F L`: the epilogue and `ret`;
  `frame_tail F L as ..`: the epilogue before a tail call;
* `frame_regs L`: register facts, enumerated per register (`forall_gpr`,
  `forall_vreg`) and discharged by `simp` on the concrete layout.

Whole-function invariants (no loop invariants to write):
* `leaf_np` / `leaf_to` + `leaf_auto pcs`: a frameless leaf that stores nothing;
* `body_loop` + `body_case`: a function with a frame that stores nothing
  outside it and calls only read-only callees (`BodyInv`); proofs of this
  kind are generated by `targets/cedar-check/gen-ro-proof.py`.

Also here: the heap (`HeapKept.of_block`, `HeapKept.write64`, `HeapKept.of_out`),
`OnlyWrites` (libc contracts) as `MemW`, `lsl`/`lsr` (`UBFM`) simp lemmas,
`umulh_eq_zero`, `atomic8_ok`.
-/

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

-- Flags after `cmn` and `ands`/`tst`, for the stepping simp set.
attribute [m1_sym] cond_eq_cmn cond_ne_cmn cond_eq_logic64 cond_ne_logic64

/-- The layout of a standard frame: its size (a multiple of 16) and the
callee-saved registers saved in it, as (register, offset from the frame base). -/
structure Layout where
  size : Nat
  /-- General-purpose registers in `x19`–`x30` (`x29`, `x30` included). -/
  gprs : List (BitVec 5 × Nat)
  /-- `d8`–`d15` (the low 64 bits of `v8`–`v15`). -/
  vregs : List (BitVec 5 × Nat) := []

/-- The slot of a register, if it is saved. -/
def slotOf : List (BitVec 5 × Nat) → BitVec 5 → Option Nat
  | [], _ => none
  | (r, o) :: t, x => if x = r then some o else slotOf t x

namespace Layout

variable (L : Layout)

/-- The frame base for an entry `SP` (the form `SP` takes after stepping the prologue). -/
def base (sp : BitVec 64) : BitVec 64 := sp + BitVec.ofNat 64 (2 ^ 64 - L.size)

/-- Byte `c` of the frame is a local: in the frame and in no save slot. -/
def Free (c : Nat) : Prop := c < L.size ∧ ∀ p ∈ L.gprs ++ L.vregs, c < p.2 ∨ p.2 + 8 ≤ c

instance (c : Nat) : Decidable (L.Free c) := by unfold Free; infer_instance

/-- What a saved (or unsaved) general-purpose register satisfies in the body. -/
def SavedG (s0 s : State) (r : BitVec 5) : Prop :=
  match slotOf L.gprs r with
  | some o => s.mem.read64 (L.base s0.sp + BitVec.ofNat 64 o) = s0.gpr r
  | none => s.gpr r = s0.gpr r

/-- The same for `d8`–`d15`. -/
def SavedV (s0 s : State) (r : BitVec 5) : Prop :=
  match slotOf L.vregs r with
  | some o => s.mem.read64 (L.base s0.sp + BitVec.ofNat 64 o) = (s0.vreg r).setWidth 64
  | none => (s.vreg r).setWidth 64 = (s0.vreg r).setWidth 64

/-- The value the epilogue restores into a general-purpose register. -/
def restoreG (s0 s : State) (r : BitVec 5) : BitVec 64 :=
  match slotOf L.gprs r with
  | some o => s.mem.read64 (L.base s0.sp + BitVec.ofNat 64 o)
  | none => s.gpr r

/-- The value the epilogue restores into `d8`–`d15`. -/
def restoreV (s0 s : State) (r : BitVec 5) : BitVec 64 :=
  match slotOf L.vregs r with
  | some o => s.mem.read64 (L.base s0.sp + BitVec.ofNat 64 o)
  | none => (s.vreg r).setWidth 64

/-- The layout is well formed: slots are 8 bytes inside the frame; `x30` is saved. -/
def WF : Prop :=
  (∀ p ∈ L.gprs ++ L.vregs, p.2 + 8 ≤ L.size) ∧ (slotOf L.gprs 30#5).isSome ∧ L.size < 2 ^ 63 ∧
    L.size % 16 = 0

instance : Decidable L.WF := by unfold WF; infer_instance

end Layout

/-- Enumerate `x19`–`x30`. -/
theorem forall_gpr {P : BitVec 5 → Prop} (h19 : P 19#5) (h20 : P 20#5) (h21 : P 21#5) (h22 : P 22#5)
    (h23 : P 23#5) (h24 : P 24#5) (h25 : P 25#5) (h26 : P 26#5) (h27 : P 27#5) (h28 : P 28#5)
    (h29 : P 29#5) (h30 : P 30#5) : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → P r := by
  intro r h1 h2
  have : r = 19#5 ∨ r = 20#5 ∨ r = 21#5 ∨ r = 22#5 ∨ r = 23#5 ∨ r = 24#5 ∨ r = 25#5 ∨ r = 26#5 ∨
    r = 27#5 ∨ r = 28#5 ∨ r = 29#5 ∨ r = 30#5 := by bv_omega
  rcases this with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> assumption

/-- Enumerate `v8`–`v15`. -/
theorem forall_vreg {P : BitVec 5 → Prop} (h8 : P 8#5) (h9 : P 9#5) (h10 : P 10#5) (h11 : P 11#5)
    (h12 : P 12#5) (h13 : P 13#5) (h14 : P 14#5) (h15 : P 15#5) :
    ∀ r : BitVec 5, 8 ≤ r.toNat → r.toNat ≤ 15 → P r := by
  intro r h1 h2
  have : r = 8#5 ∨ r = 9#5 ∨ r = 10#5 ∨ r = 11#5 ∨ r = 12#5 ∨ r = 13#5 ∨ r = 14#5 ∨ r = 15#5 := by
    bv_omega
  rcases this with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> assumption

/-- The invariant of a function body with frame layout `L` (entry state `s0`,
current state `s`; the stack is `[lo, top)`; the declared output is the `n`
bytes at `out`). -/
structure Frame (L : Layout) (lo top out : BitVec 64) (n : Nat) (s0 s : State) : Prop where
  wf : L.WF
  al : s0.sp &&& 15#64 = 0#64
  /-- The stack has room for the frame. -/
  room : L.size ≤ (s0.sp - lo).toNat
  room' : (s0.sp - lo).toNat ≤ (top - lo).toNat
  /-- The TLV descriptor is off the stack (`MemFacts.tlvOffStack`). -/
  tlvOff : ∀ i < 8, ¬ OnStack lo top (tlvDesc + BitVec.ofNat 64 i)
  sp : s.sp = L.base s0.sp
  gpr : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → L.SavedG s0 s r
  vreg : ∀ r : BitVec 5, 8 ≤ r.toNat → r.toNat ≤ 15 → L.SavedV s0 s r
  fpcr : s.fpcr = s0.fpcr
  keeps : Keeps top out n s0 s
  tlv : s.mem.read64 tlvDesc = s0.mem.read64 tlvDesc

/-- The bytes the body may write: locals (frame bytes that are no save slot),
the declared output (which must be in the caller's part of the stack), and
memory off the stack other than the TLV descriptor (e.g. the heap; the frame
invariant says nothing about it). -/
def Frame.W (L : Layout) (lo top out : BitVec 64) (n : Nat) (s0 : State) (x : BitVec 64) : Prop :=
  L.Free (x - L.base s0.sp).toNat ∨ ((x - out).toNat < n ∧ (x - s0.sp).toNat < (top - s0.sp).toNat) ∨
    (¬ OnStack lo top x ∧ ∀ i < 8, x ≠ tlvDesc + BitVec.ofNat 64 i)

/-- The `NPContract` postcondition, as `SafeFun` states it for a return to `s0`'s caller. -/
abbrev NPPost (top out : BitVec 64) (k : Nat) (post : State → State → Prop) (s0 s' : State) : Prop :=
  s'.pc = s0.gpr 30 ∧ s'.status = .running ∧ (CalleeSaved s0 s' ∧ Keeps top out k s0 s' ∧
    s'.mem.read64 tlvDesc = s0.mem.read64 tlvDesc ∧ post s0 s')

/-- Memory changes confined to `A`. -/
def MemW (A : BitVec 64 → Prop) (m m' : Memory) : Prop := ∀ x, m' x ≠ m x → A x

namespace MemW

variable {A : BitVec 64 → Prop}

theorem refl (m : Memory) : MemW A m m := fun _ h => absurd rfl h

theorem trans {m₁ m₂ m₃ : Memory} (h₁ : MemW A m₁ m₂) (h₂ : MemW A m₂ m₃) : MemW A m₁ m₃ := by
  intro x hx
  by_cases h : m₂ x = m₁ x
  · exact h₂ x (by rwa [h])
  · exact h₁ x h

theorem mono {B : BitVec 64 → Prop} {m m' : Memory} (h : MemW A m m') (hab : ∀ x, A x → B x) :
    MemW B m m' := fun x hx => hab x (h x hx)

theorem of_eq {m m' : Memory} (h : m' = m) : MemW A m m' := fun _ hx => absurd (by rw [h]) hx

theorem of_writes {m' m : Memory} {w : BitVec 64} {k : Nat} {f : Nat → BitVec 8}
    (hw : Memory.Writes m' m w k f) (h : ∀ i < k, A (w + BitVec.ofNat 64 i)) : MemW A m m' := by
  intro x hx
  rw [hw x] at hx
  by_cases hc : (x - w).toNat < k
  · have := h _ hc
    rwa [BitVec.ofNat_toNat, BitVec.setWidth_eq, BitVec.add_comm, BitVec.sub_add_cancel] at this
  · rw [ite_eq_right_iff.mpr (fun h => absurd h hc)] at hx; exact absurd rfl hx

theorem write8 {m : Memory} {w : BitVec 64} (v : BitVec 8) (h : ∀ i < 1, A (w + BitVec.ofNat 64 i)) :
    MemW A m (m.write8 w v) := of_writes (Memory.writes8 m w v) h
theorem write16 {m : Memory} {w : BitVec 64} (v : BitVec 16) (h : ∀ i < 2, A (w + BitVec.ofNat 64 i)) :
    MemW A m (m.write16 w v) := of_writes (Memory.writes16 m w v) h
theorem write32 {m : Memory} {w : BitVec 64} (v : BitVec 32) (h : ∀ i < 4, A (w + BitVec.ofNat 64 i)) :
    MemW A m (m.write32 w v) := of_writes (Memory.writes32 m w v) h
theorem write64 {m : Memory} {w : BitVec 64} (v : BitVec 64) (h : ∀ i < 8, A (w + BitVec.ofNat 64 i)) :
    MemW A m (m.write64 w v) := of_writes (Memory.writes64 m w v) h
theorem write128 {m : Memory} {w : BitVec 64} (v : BitVec 128) (h : ∀ i < 16, A (w + BitVec.ofNat 64 i)) :
    MemW A m (m.write128 w v) := of_writes (Memory.writes128 m w v) h

/-- A read outside the changed bytes is unchanged. -/
theorem read64 {m m' : Memory} (h : MemW A m m') {a : BitVec 64}
    (ha : ∀ i < 8, ¬ A (a + BitVec.ofNat 64 i)) : m'.read64 a = m.read64 a :=
  Memory.read64_congr fun i hi => Classical.byContradiction fun hc => ha i hi (h _ hc)

end MemW

/-! ### Arithmetic on frame offsets -/

section Arith

variable {lo top sp x : BitVec 64} {F : Nat}

/-- Offsets from the frame base. -/
theorem sub_base (x sp : BitVec 64) (F : Nat) (hF : F < 2 ^ 64) :
    (x - (sp + BitVec.ofNat 64 (2 ^ 64 - F))).toNat = ((x - sp).toNat + F) % 2 ^ 64 := by
  rw [Memory.toNat_sub_add]
  have := (x - sp).isLt
  by_cases h : F = 0
  · subst h
    rw [Nat.sub_zero, Nat.add_mod_right, Nat.add_zero]
  · rw [Nat.mod_eq_of_lt (a := 2 ^ 64 - F) (by omega)]; congr 1; omega

/-- `top - sp` in terms of `top - lo` and `sp - lo`. -/
theorem top_sub (h : (sp - lo).toNat ≤ (top - lo).toNat) :
    (top - sp).toNat = (top - lo).toNat - (sp - lo).toNat := by
  rw [show top - sp = (top - lo) - (sp - lo) by grind,
    BitVec.toNat_sub_of_le (by rw [BitVec.le_def]; omega)]

/-- A byte in the caller's part of the stack is not in the frame. -/
theorem not_frame (hF : F ≤ (sp - lo).toNat) (h' : (sp - lo).toNat ≤ (top - lo).toNat)
    (hx : (x - sp).toNat < (top - sp).toNat) :
    F ≤ (x - (sp + BitVec.ofNat 64 (2 ^ 64 - F))).toNat := by
  have := (top - lo).isLt
  rw [sub_base _ _ _ (by omega), top_sub h'] at *
  rw [Nat.mod_eq_of_lt (by omega)]
  omega

/-- A frame byte is on the stack, below the entry `SP`. -/
theorem frame_onStack (hF : F ≤ (sp - lo).toNat) (h' : (sp - lo).toNat ≤ (top - lo).toNat)
    (hx : (x - (sp + BitVec.ofNat 64 (2 ^ 64 - F))).toNat < F) :
    OnStack lo top x ∧ (x - lo).toNat < (sp - lo).toNat := by
  have hlt := (top - lo).isLt
  have e : x - lo = (x - (sp + BitVec.ofNat 64 (2 ^ 64 - F))) + ((sp - lo) - BitVec.ofNat 64 F) := by
    have : BitVec.ofNat 64 (2 ^ 64 - F) = 0#64 - BitVec.ofNat 64 F := by
      apply BitVec.eq_of_toNat_eq
      simp only [BitVec.toNat_ofNat, BitVec.toNat_sub]
      by_cases h : F = 0
      · subst h; simp
      · rw [Nat.mod_eq_of_lt (a := F) (by omega)]; omega
    rw [this]; bv_omega
  have hs : ((sp - lo) - BitVec.ofNat 64 F).toNat = (sp - lo).toNat - F := by
    rw [BitVec.toNat_sub_of_le] <;> simp only [BitVec.toNat_ofNat, BitVec.le_def] <;>
      rw [Nat.mod_eq_of_lt (by omega)] <;> omega
  unfold OnStack
  rw [e, BitVec.toNat_add, hs, Nat.mod_eq_of_lt (by omega)]
  omega

/-- A byte in the caller's part of the stack is on the stack. -/
theorem above_onStack (h' : (sp - lo).toNat ≤ (top - lo).toNat)
    (hx : (x - sp).toNat < (top - sp).toNat) : OnStack lo top x := by
  have := onStack_above (n := 1) h' (w := x) (by omega) 0 (by decide)
  simpa using this

/-- A byte on the stack is not a TLV byte. -/
theorem not_tlv (hoff : ∀ i < 8, ¬ OnStack lo top (tlvDesc + BitVec.ofNat 64 i)) (hx : OnStack lo top x) :
    ∀ i < 8, tlvDesc + BitVec.ofNat 64 i ≠ x := fun i hi he => hoff i hi (he ▸ hx)

end Arith

namespace Frame

variable {L : Layout} {lo top out : BitVec 64} {n : Nat} {s0 s s' : State}

theorem size_lt (h : Frame L lo top out n s0 s) : L.size < 2 ^ 64 := by
  have := h.wf.2.2; omega

/-- The bytes `[s.sp, s0.sp)` of the frame are above the current `SP`. -/
theorem top_sub_sp (h : Frame L lo top out n s0 s) :
    (top - s.sp).toNat = (top - s0.sp).toNat + L.size := by
  have := (top - lo).isLt; have := h.room; have := h.room'
  rw [h.sp, Layout.base, sub_base _ _ _ h.size_lt, top_sub h.room']
  rw [Nat.mod_eq_of_lt (by omega)]

/-- A writable byte is not a TLV byte. -/
theorem W_tlv (h : Frame L lo top out n s0 s) {x : BitVec 64} (hx : Frame.W L lo top out n s0 x) :
    ∀ i < 8, x ≠ tlvDesc + BitVec.ofNat 64 i := by
  rcases hx with hx | ⟨-, hx⟩ | ⟨-, hx⟩
  · exact fun i hi he => h.tlvOff i hi (he ▸ (frame_onStack h.room h.room' hx.1).1)
  · exact fun i hi he => h.tlvOff i hi (he ▸ above_onStack h.room' hx)
  · exact hx

/-- A writable byte is not in a save slot. -/
theorem W_slot (h : Frame L lo top out n s0 s) {x : BitVec 64} (hx : Frame.W L lo top out n s0 x)
    (p : BitVec 5 × Nat) (hp : p ∈ L.gprs ++ L.vregs) (i : Nat) (hi : i < 8) :
    x ≠ L.base s0.sp + BitVec.ofNat 64 p.2 + BitVec.ofNat 64 i := by
  have hsl := h.wf.1 p hp
  have hlt := h.size_lt
  intro he
  have hc : (x - L.base s0.sp).toNat = p.2 + i := by
    rw [he, BitVec.add_assoc, BitVec.add_comm (L.base s0.sp), BitVec.add_sub_cancel,
      ← BitVec.ofNat_add, BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
  rcases hx with ⟨-, hx⟩ | ⟨-, hx⟩ | ⟨hx, -⟩
  · rcases hx p hp with h1 | h1 <;> omega
  · have := not_frame h.room h.room' hx
    unfold Layout.base at hc
    omega
  · exact hx (frame_onStack h.room h.room' (by unfold Layout.base at hc; omega)).1

/-- Save-slot bytes are in the callee's part of the stack at a call. -/
theorem slot_above (h : Frame L lo top out n s0 s) (o : Nat) (ho : o + 8 ≤ L.size) (i : Nat) (hi : i < 8) :
    (L.base s0.sp + BitVec.ofNat 64 o + BitVec.ofNat 64 i - s.sp).toNat < (top - s.sp).toNat := by
  have hlt := h.size_lt
  rw [h.top_sub_sp, h.sp, BitVec.add_assoc, BitVec.add_comm (L.base s0.sp), BitVec.add_sub_cancel,
    ← BitVec.ofNat_add, BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
  omega

theorem slot_mem {l : List (BitVec 5 × Nat)} {r : BitVec 5} {o : Nat}
    (h : slotOf l r = some o) : (r, o) ∈ l := by
  induction l with
  | nil => simp [slotOf] at h
  | cons q t ih =>
    obtain ⟨a, b⟩ := q
    simp only [slotOf] at h
    split at h
    · cases h; subst_vars; exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (ih h)

/-- **Stores and register updates.** `Frame` survives a change of the
registers other than the unsaved callee-saved ones and of the writable bytes. -/
theorem update (h : Frame L lo top out n s0 s) (hsp : s'.sp = s.sp)
    (hg : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → slotOf L.gprs r = none → s'.gpr r = s.gpr r)
    (hv : ∀ r : BitVec 5, 8 ≤ r.toNat → r.toNat ≤ 15 → slotOf L.vregs r = none →
      (s'.vreg r).setWidth 64 = (s.vreg r).setWidth 64)
    (hf : s'.fpcr = s.fpcr) (hm : MemW (Frame.W L lo top out n s0) s.mem s'.mem) :
    Frame L lo top out n s0 s' := by
  have slot : ∀ p ∈ L.gprs ++ L.vregs,
      s'.mem.read64 (L.base s0.sp + BitVec.ofNat 64 p.2) = s.mem.read64 (L.base s0.sp + BitVec.ofNat 64 p.2) :=
    fun p hp => hm.read64 fun i hi hw => h.W_slot hw p hp i hi rfl
  refine ⟨h.wf, h.al, h.room, h.room', h.tlvOff, hsp.trans h.sp, fun r h1 h2 => ?_, fun r h1 h2 => ?_,
    hf.trans h.fpcr, ?_, ?_⟩
  · have := h.gpr r h1 h2
    rcases ho : slotOf L.gprs r with _ | o <;> simp only [Layout.SavedG, ho] at this ⊢
    · rw [hg r h1 h2 ho]; exact this
    · rw [slot (r, o) (List.mem_append_left _ (slot_mem ho))]; exact this
  · have := h.vreg r h1 h2
    rcases ho : slotOf L.vregs r with _ | o <;> simp only [Layout.SavedV, ho] at this ⊢
    · rw [hv r h1 h2 ho]; exact this
    · rw [slot (r, o) (List.mem_append_right _ (slot_mem ho))]; exact this
  · intro a h1 h2
    rw [← h.keeps a h1 h2]
    apply Classical.byContradiction; intro hc
    rcases hm a hc with ha | ⟨ha, -⟩ | ⟨ha, -⟩
    · have := not_frame h.room h.room' h1; exact absurd ha.1 (by unfold Layout.base; omega)
    · omega
    · exact ha (above_onStack h.room' h1)
  · rw [← h.tlv]
    exact Memory.read64_congr fun i hi => Classical.byContradiction fun hc =>
      h.W_tlv (hm _ hc) i hi rfl

/-- Locals: `k` bytes at offset `c` from the frame base, in no save slot. -/
theorem wr_local (h : Frame L lo top out n s0 s) {w : BitVec 64} {c k : Nat}
    (hw : (w - L.base s0.sp).toNat = c) (hfree : ∀ i < k, L.Free (c + i)) :
    ∀ i < k, Frame.W L lo top out n s0 (w + BitVec.ofNat 64 i) := by
  intro i hi
  left
  have hlt := h.size_lt
  have := (hfree i hi).1
  rw [show w + BitVec.ofNat 64 i - L.base s0.sp = (w - L.base s0.sp) + BitVec.ofNat 64 i by grind,
    BitVec.toNat_add, hw, BitVec.toNat_ofNat, Nat.mod_eq_of_lt (a := i) (by omega),
    Nat.mod_eq_of_lt (by omega)]
  exact hfree i hi

/-- The declared output: `k` bytes at offset `d` from `out`, in the caller's
part of the stack. -/
theorem wr_out (_h : Frame L lo top out n s0 s) {w : BitVec 64} {d k : Nat}
    (hw : (w - out).toNat = d) (hdk : d + k ≤ n)
    (hout : (out - s0.sp).toNat + n ≤ (top - s0.sp).toNat) :
    ∀ i < k, Frame.W L lo top out n s0 (w + BitVec.ofNat 64 i) := by
  intro i hi
  right; left
  have := (top - s0.sp).isLt
  have e1 : (w + BitVec.ofNat 64 i - out).toNat = d + i := by
    rw [show w + BitVec.ofNat 64 i - out = (w - out) + BitVec.ofNat 64 i by grind,
      BitVec.toNat_add, hw, BitVec.toNat_ofNat, Nat.mod_eq_of_lt (a := i) (by omega),
      Nat.mod_eq_of_lt (by omega)]
  refine ⟨by omega, ?_⟩
  rw [show w + BitVec.ofNat 64 i - s0.sp = (w + BitVec.ofNat 64 i - out) + (out - s0.sp) by grind,
    BitVec.toNat_add, e1, Nat.mod_eq_of_lt (by omega)]
  omega

/-- Inside a live heap block. -/
theorem wr_heap {H : Heap} (hM : MemFacts H lo top) {m : Memory} {b nb al w : BitVec 64} {k : Nat}
    (hl : H.Live m b nb al) (hw : (w - b).toNat + k ≤ nb.toNat) :
    ∀ i < k, Frame.W L lo top out n s0 (w + BitVec.ofNat 64 i) := by
  intro i hi
  right; right
  have e : w + BitVec.ofNat 64 i = b + BitVec.ofNat 64 ((w - b).toNat + i) := by
    rw [BitVec.ofNat_add, BitVec.ofNat_toNat, BitVec.setWidth_eq]; grind
  rw [e]
  refine ⟨hM.offStack _ _ _ _ hl _ (by omega), fun j hj he => ?_⟩
  have hd := hM.offTlv _ _ _ _ hl
  have := hd.offset (by omega) j hj
  rw [← he, show ∀ x y : BitVec 64, x + y - x = y from fun _ _ => by grind, BitVec.toNat_ofNat] at this
  have := nb.isLt
  rw [Nat.mod_eq_of_lt (by omega)] at *
  omega

/-- **Calls.** `Frame` survives a call entered with `SP` at the frame base
whose contract gives `CalleeSaved`, `Keeps` (its output, `k` bytes at `o`,
writable for us) and the TLV descriptor. -/
theorem call (h : Frame L lo top out n s0 s) (hcs : CalleeSaved s s') {o : BitVec 64} {k : Nat}
    (hk : Keeps top o k s s') (htl : s'.mem.read64 tlvDesc = s.mem.read64 tlvDesc)
    (ho : ∀ i < k, Frame.W L lo top out n s0 (o + BitVec.ofNat 64 i)) : Frame L lo top out n s0 s' := by
  have hlt := h.size_lt
  have h30 := h.wf.2.1
  -- Bytes the callee may change and that matter to us are its output.
  have kept : ∀ x, (x - s.sp).toNat < (top - s.sp).toNat → ¬ Frame.W L lo top out n s0 x → s'.mem x = s.mem x := by
    intro x hx hw
    apply hk x hx
    apply Classical.byContradiction; intro hc
    apply hw
    have := ho _ (by omega : (x - o).toNat < k)
    rwa [BitVec.ofNat_toNat, BitVec.setWidth_eq, BitVec.add_comm, BitVec.sub_add_cancel] at this
  have slot : ∀ p ∈ L.gprs ++ L.vregs,
      s'.mem.read64 (L.base s0.sp + BitVec.ofNat 64 p.2) = s.mem.read64 (L.base s0.sp + BitVec.ofNat 64 p.2) := by
    intro p hp
    apply Memory.read64_congr; intro i hi
    exact kept _ (h.slot_above p.2 (h.wf.1 p hp) i hi) fun hw => h.W_slot hw p hp i hi rfl
  refine ⟨h.wf, h.al, h.room, h.room', h.tlvOff, hcs.sp.trans h.sp, fun r h1 h2 => ?_, fun r h1 h2 => ?_,
    hcs.fpcr.trans h.fpcr, ?_, htl.trans h.tlv⟩
  · have := h.gpr r h1 h2
    rcases ho' : slotOf L.gprs r with _ | o' <;> simp only [Layout.SavedG, ho'] at this ⊢
    · have : r.toNat ≤ 29 := by
        apply Classical.byContradiction; intro hc
        have : r = 30#5 := by bv_omega
        subst this; rw [ho'] at h30; simp at h30
      rw [hcs.gpr r h1 this]; assumption
    · rw [slot (r, o') (List.mem_append_left _ (slot_mem ho'))]; exact this
  · have := h.vreg r h1 h2
    rcases ho' : slotOf L.vregs r with _ | o' <;> simp only [Layout.SavedV, ho'] at this ⊢
    · rw [hcs.2.2.1 r h1 h2]; exact this
    · rw [slot (r, o') (List.mem_append_right _ (slot_mem ho'))]; exact this
  · intro a h1 h2
    rw [← h.keeps a h1 h2]
    apply kept
    · have e := h.top_sub_sp
      have := (top - s.sp).isLt
      rw [e, h.sp, Layout.base, sub_base _ _ _ hlt, Nat.mod_eq_of_lt (by omega)]
      omega
    · rintro (hw | ⟨hw, -⟩ | ⟨hw, -⟩)
      · exact absurd hw.1 (by have := not_frame h.room h.room' h1; unfold Layout.base; omega)
      · omega
      · exact hw (above_onStack h.room' h1)

/-- **Epilogue.** After the epilogue (`SP` back at the entry value, the saved
registers reloaded, memory unchanged since the body), the `NPContract` frame
conditions hold. -/
theorem ret (h : Frame L lo top out n s0 s) (hsp : s'.sp = s0.sp)
    (hg : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → s'.gpr r = L.restoreG s0 s r)
    (hv : ∀ r : BitVec 5, 8 ≤ r.toNat → r.toNat ≤ 15 → (s'.vreg r).setWidth 64 = L.restoreV s0 s r)
    (hf : s'.fpcr = s.fpcr) (hm : s'.mem = s.mem) :
    CalleeSaved s0 s' ∧ s'.gpr 30 = s0.gpr 30 ∧ Keeps top out n s0 s' ∧
      s'.mem.read64 tlvDesc = s0.mem.read64 tlvDesc := by
  have G : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → s'.gpr r = s0.gpr r := by
    intro r h1 h2
    have := h.gpr r h1 h2
    rw [hg r h1 h2]
    unfold Layout.SavedG at this; unfold Layout.restoreG
    split <;> simp_all
  refine ⟨⟨fun r h1 h2 => G r h1 (by omega), hsp, fun r h1 h2 => ?_, hf.trans h.fpcr⟩, G 30#5 (by decide) (by decide),
    fun a h1 h2 => by rw [hm]; exact h.keeps a h1 h2, by rw [hm]; exact h.tlv⟩
  have := h.vreg r h1 h2
  rw [hv r h1 h2]
  unfold Layout.SavedV at this; unfold Layout.restoreV
  split <;> simp_all

/-- The `NPContract` postcondition after `ret` (with the function's own `post`). -/
theorem ret_np (h : Frame L lo top out n s0 s) (hsp : s'.sp = s0.sp)
    (hg : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → s'.gpr r = L.restoreG s0 s r)
    (hv : ∀ r : BitVec 5, 8 ≤ r.toNat → r.toNat ≤ 15 → (s'.vreg r).setWidth 64 = L.restoreV s0 s r)
    (hf : s'.fpcr = s.fpcr) (hm : s'.mem = s.mem) (hpc : s'.pc = s'.gpr 30) (hst : s'.status = .running)
    {post : State → State → Prop} (hpost : post s0 s') : NPPost top out n post s0 s' := by
  obtain ⟨hcs, h30, hk, htl⟩ := h.ret hsp hg hv hf hm
  exact ⟨hpc.trans h30, hst, hcs, hk, htl, hpost⟩

end Frame

/-- **Tail calls.** The frame conditions at the jump (from `Frame.ret`) and the
callee's contract (its output inside ours) give the caller's. -/
theorem tail_np {top out o : BitVec 64} {n k : Nat} {s0 st s' : State}
    (hcs : CalleeSaved s0 st) (h30 : st.gpr 30 = s0.gpr 30) (hk : Keeps top out n s0 st)
    (htl : st.mem.read64 tlvDesc = s0.mem.read64 tlvDesc)
    (hpc' : s'.pc = st.gpr 30) (hst' : s'.status = .running)
    (hcs' : CalleeSaved st s') (hk' : Keeps top o k st s')
    (htl' : s'.mem.read64 tlvDesc = st.mem.read64 tlvDesc)
    (ho : k = 0 ∨ ∀ x, (x - o).toNat < k → (x - out).toNat < n)
    {post : State → State → Prop} (hpost : post s0 s') : NPPost top out n post s0 s' := by
  refine ⟨hpc'.trans h30, hst', hcs.trans hcs', ?_, htl'.trans htl, hpost⟩
  refine Keeps.trans hk ?_ hcs.sp
  intro a h1 h2
  apply hk' a h1
  rcases ho with rfl | ho
  · exact Nat.zero_le _
  · exact Nat.not_lt.mp fun hc => absurd (ho a hc) (by omega)

/-- **Prologue.** After the prologue: `SP` at the frame base, the saved
registers' slots hold their entry values, unsaved callee-saved registers
unchanged, memory changed only in the frame. -/
theorem Frame.intro {L : Layout} {lo top out : BitVec 64} {n : Nat} {s0 s : State}
    (wf : L.WF) (al : s0.sp &&& 15#64 = 0#64) (room : L.size ≤ (s0.sp - lo).toNat)
    (room' : (s0.sp - lo).toNat ≤ (top - lo).toNat)
    (tlvOff : ∀ i < 8, ¬ OnStack lo top (tlvDesc + BitVec.ofNat 64 i))
    (hsp : s.sp = L.base s0.sp)
    (hg : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → L.SavedG s0 s r)
    (hv : ∀ r : BitVec 5, 8 ≤ r.toNat → r.toNat ≤ 15 → L.SavedV s0 s r)
    (hf : s.fpcr = s0.fpcr)
    (hm : MemW (fun x => (x - L.base s0.sp).toNat < L.size) s0.mem s.mem) :
    Frame L lo top out n s0 s := by
  refine ⟨wf, al, room, room', tlvOff, hsp, hg, hv, hf, ?_, ?_⟩
  · intro a h1 _
    apply Classical.byContradiction; intro hc
    have := hm a hc
    have := not_frame room room' h1
    unfold Layout.base at *; omega
  · exact Memory.read64_congr fun i hi => Classical.byContradiction fun hc =>
      tlvOff i hi (frame_onStack room room' (hm _ hc)).1

/-- Changes confined to the frame (below the entry `SP`) are confined to the
stack: they keep the heap (`StackOnly.heapKept`) and off-stack reads. -/
theorem MemW.stackOnly {L : Layout} {lo top : BitVec 64} {s0 : State} {m m' : Memory}
    (room : L.size ≤ (s0.sp - lo).toNat) (room' : (s0.sp - lo).toNat ≤ (top - lo).toNat)
    (h : MemW (fun x => (x - L.base s0.sp).toNat < L.size) m m') : StackOnly lo top m m' :=
  fun x hx => Classical.byContradiction fun hc => hx (frame_onStack room room' (h x hc)).1


end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

/-- `k` bytes at `a` are not in the free part of the stack `[lo, sp)`: a
pointer argument points into the callers' frames or off the stack. -/
def Outside (lo sp a : BitVec 64) (k : Nat) : Prop :=
  ∀ i < k, ¬ (a + BitVec.ofNat 64 i - lo).toNat < (sp - lo).toNat

theorem MemW.write64' {A : BitVec 64 → Prop} {m m' : Memory} {w : BitVec 64} (v : BitVec 64)
    (h : MemW A m m') (hw : ∀ i < 8, A (w + BitVec.ofNat 64 i)) : MemW A m (m'.write64 w v) :=
  h.trans (MemW.write64 v hw)
theorem MemW.write32' {A : BitVec 64 → Prop} {m m' : Memory} {w : BitVec 64} (v : BitVec 32)
    (h : MemW A m m') (hw : ∀ i < 4, A (w + BitVec.ofNat 64 i)) : MemW A m (m'.write32 w v) :=
  h.trans (MemW.write32 v hw)
theorem MemW.write16' {A : BitVec 64 → Prop} {m m' : Memory} {w : BitVec 64} (v : BitVec 16)
    (h : MemW A m m') (hw : ∀ i < 2, A (w + BitVec.ofNat 64 i)) : MemW A m (m'.write16 w v) :=
  h.trans (MemW.write16 v hw)
theorem MemW.write8' {A : BitVec 64 → Prop} {m m' : Memory} {w : BitVec 64} (v : BitVec 8)
    (h : MemW A m m') (hw : ∀ i < 1, A (w + BitVec.ofNat 64 i)) : MemW A m (m'.write8 w v) :=
  h.trans (MemW.write8 v hw)
theorem MemW.write128' {A : BitVec 64 → Prop} {m m' : Memory} {w : BitVec 64} (v : BitVec 128)
    (h : MemW A m m') (hw : ∀ i < 16, A (w + BitVec.ofNat 64 i)) : MemW A m (m'.write128 w v) :=
  h.trans (MemW.write128 v hw)

/-- The offset of a store in the prologue, relative to the frame base. -/
theorem off_in_frame {x c c0 : BitVec 64} {k F : Nat} (h : (c - c0).toNat + k ≤ F) :
    ∀ i < k, (x + c + BitVec.ofNat 64 i - (x + c0)).toNat < F := by
  intro i hi
  rw [show x + c + BitVec.ofNat 64 i - (x + c0) = (c - c0) + BitVec.ofNat 64 i by grind,
    BitVec.toNat_add, BitVec.toNat_ofNat]
  have := (c - c0).isLt
  omega

/-- What holds after the prologue (at `pc`): the frame invariant, the argument
registers `x0`–`x18` and the vector registers unchanged, memory changed only
in the frame. -/
structure Entered (L : Layout) (lo top out : BitVec 64) (n : Nat) (pc : BitVec 64) (s0 s : State) : Prop where
  pc : s.pc = pc
  status : s.status = .running
  frame : Frame L lo top out n s0 s
  args : ∀ r : BitVec 5, r.toNat < 19 → s.gpr r = s0.gpr r
  vreg : s.vreg = s0.vreg
  mem : MemW (fun x => (x - L.base s0.sp).toNat < L.size) s0.mem s.mem

theorem Entered.intro {L : Layout} {lo top out : BitVec 64} {n : Nat} {pc : BitVec 64} {s0 s : State}
    (wf : L.WF) (al : s0.sp &&& 15#64 = 0#64) (room : L.size ≤ (s0.sp - lo).toNat)
    (room' : (s0.sp - lo).toNat ≤ (top - lo).toNat)
    (tlvOff : ∀ i < 8, ¬ OnStack lo top (tlvDesc + BitVec.ofNat 64 i))
    (hpc : s.pc = pc) (hst : s.status = .running) (hsp : s.sp = L.base s0.sp)
    (hg : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → L.SavedG s0 s r)
    (hvs : ∀ r : BitVec 5, 8 ≤ r.toNat → r.toNat ≤ 15 → L.SavedV s0 s r)
    (hargs : ∀ r : BitVec 5, r.toNat < 19 → s.gpr r = s0.gpr r)
    (hv : s.vreg = s0.vreg) (hf : s.fpcr = s0.fpcr)
    (hm : MemW (fun x => (x - L.base s0.sp).toNat < L.size) s0.mem s.mem) :
    Entered L lo top out n pc s0 s :=
  ⟨hpc, hst, Frame.intro wf al room room' tlvOff hsp hg hvs hf hm, hargs, hv, hm⟩

/-- Memory outside the free part of the stack is unchanged by the prologue. -/
theorem Entered.read64 {L : Layout} {lo top out : BitVec 64} {n : Nat} {pc : BitVec 64} {s0 s : State}
    (E : Entered L lo top out n pc s0 s) {a : BitVec 64} (ha : Outside lo s0.sp a 8) :
    s.mem.read64 a = s0.mem.read64 a :=
  E.mem.read64 fun i hi hc => ha i hi (frame_onStack E.frame.room E.frame.room' hc).2

/-- The prologue changes only the stack. -/
theorem Entered.stackOnly {L : Layout} {lo top out : BitVec 64} {n : Nat} {pc : BitVec 64} {s0 s : State}
    (E : Entered L lo top out n pc s0 s) : StackOnly lo top s0.mem s.mem :=
  MemW.stackOnly E.frame.room E.frame.room' E.mem

/-- A live block's bytes are `Outside` (off the stack). -/
theorem Outside.of_live {H : Heap} {lo top : BitVec 64} (hM : MemFacts H lo top) {m : Memory}
    {b nb al : BitVec 64} (hl : H.Live m b nb al) {sp : BitVec 64}
    (hsp : (sp - lo).toNat ≤ (top - lo).toNat) {a : BitVec 64} {k : Nat}
    (ha : (a - b).toNat + k ≤ nb.toNat) : Outside lo sp a k := by
  intro i hi hc
  have e : a + BitVec.ofNat 64 i = b + BitVec.ofNat 64 ((a - b).toNat + i) := by
    rw [BitVec.ofNat_add, BitVec.ofNat_toNat, BitVec.setWidth_eq]; grind
  rw [e] at hc
  exact hM.offStack _ _ _ _ hl ((a - b).toNat + i) (by omega) (by unfold OnStack; omega)

end Examples.Cedar.NoPanic

/-! ### Tactics -/

namespace Examples.Cedar.NoPanic
open M1 Lean Examples.Cedar.Eval

theorem sub_add_add_left (x a b : BitVec 64) : x + a - (x + b) = a - b := by bv_omega
theorem add_sub_self_left (x a : BitVec 64) : x + a - x = a := by bv_omega
theorem sub_self_add (x b : BitVec 64) : x - (x + b) = 0#64 - b := by bv_omega

/-- The stack has room for `F` bytes below `SP` (`[lo, top)` is the stack). -/
def Room (lo top : BitVec 64) (F : Nat) (s : State) : Prop :=
  F ≤ (s.sp - lo).toNat ∧ (s.sp - lo).toNat ≤ (top - lo).toNat

/-- The prologue writes only registers `x19`–`x30` (and `SP`). -/
theorem upd_ge19 {β : Type} (f : BitVec 5 → β) (a r : BitVec 5) (b : β) (ha : 19 ≤ a.toNat)
    (hr : r.toNat < 19) : M1.upd f a b r = f r :=
  M1.upd_other f a r b (fun h => by subst h; omega)

/-- Run the prologue (up to `pc`) and continue from the state `s1` after it. -/
theorem Entered.run {p : Program} {B : BitVec 64 → Prop} {n : Nat} {s : State} {Q : State → Prop}
    (L : Layout) (lo top out : BitVec 64) (k : Nat) (pc : BitVec 64)
    (h1 : SafeN p B n s (Entered L lo top out k pc s))
    (h2 : ∀ s1, Entered L lo top out k pc s s1 → SafeN p B n s1 Q) : SafeN p B n s Q :=
  h1.trans h2

/-- `L.size` is a multiple of 16, so `SP` stays aligned in the body. -/
theorem Frame.al_sp {L : Layout} {lo top out : BitVec 64} {n : Nat} {s0 s : State}
    (h : Frame L lo top out n s0 s) (h16 : L.size % 16 = 0 := by decide) : s.sp &&& 15#64 = 0#64 := by
  rw [h.sp, Layout.base, add_and15 _ _ ?_, h.al]
  have := h.size_lt
  apply BitVec.eq_of_toNat_eq
  simp only [BitVec.toNat_and, BitVec.toNat_ofNat]
  rw [Nat.mod_eq_of_lt (a := 15) (by decide)]
  by_cases h0 : L.size = 0
  · simp [h0]
  · rw [Nat.mod_eq_of_lt (by omega)]
    have : (2 ^ 64 - L.size) % 16 = 0 := by omega
    rw [show (15 : Nat) = 2 ^ 4 - 1 by rfl, Nat.and_two_pow_sub_one_eq_mod]; simpa using this

/-- The simp set that evaluates a concrete layout (`L`, a definition) and its
register facts, with offsets as literals. -/
syntax "frame_simp" ident (Lean.Parser.Tactic.location)? : tactic
macro_rules
  | `(tactic| frame_simp $L $[$loc]?) =>
    `(tactic| simp only [$L:ident, Layout.SavedG, Layout.SavedV, Layout.restoreG, Layout.restoreV, slotOf,
      Layout.base, M1.upd, BitVec.reduceEq, ite_true, ite_false, reduceIte, Option.some.injEq, reduceCtorEq,
      imp_self, implies_true, forall_const, true_implies, false_implies, BitVec.ofNat_eq_ofNat,
      BitVec.add_zero, BitVec.add_assoc, BitVec.reduceAdd, BitVec.reduceSub, BitVec.reduceToNat,
      Nat.reducePow, Nat.reduceSub, Nat.reduceAdd, sub_add_add_left, add_sub_self_left, sub_self_add,
      M1.State.mk.injEq, true_and, and_true] $[$loc]?)

/-- Discharge `∀ r, 19 ≤ r.toNat → r.toNat ≤ 30 → P r` and
`∀ r, 8 ≤ r.toNat → r.toNat ≤ 15 → P r` register by register. -/
macro "frame_regs" L:ident : tactic =>
  `(tactic| first
    | (apply forall_gpr <;> frame_simp $L <;> (try m1_simp_step) <;> done)
    | (apply forall_vreg <;> frame_simp $L <;> (try m1_simp_step) <;> done))

macro "frame_mem_step" : tactic =>
  `(tactic| first
      | refine MemW.write64' _ ?_ (off_in_frame (by decide))
      | refine MemW.write128' _ ?_ (off_in_frame (by decide))
      | refine MemW.write32' _ ?_ (off_in_frame (by decide))
      | refine MemW.write16' _ ?_ (off_in_frame (by decide))
      | refine MemW.write8' _ ?_ (off_in_frame (by decide)))

/-- `MemW _ m (m.writeK ...)` for the prologue's stores into the frame. -/
macro "frame_prologue_mem" : tactic => `(tactic| ((repeat frame_mem_step); exact MemW.refl _))

/-- Step the prologue of a function with layout `L` (up to `pc`) and continue
from the state `s1` after it, with `E : Entered L lo top out k pc s s1`. Needs in
context: `s.pc = entry`, `s.status = .running`, `s.sp &&& 15 = 0`,
`L.size ≤ (s.sp - lo).toNat`, `(s.sp - lo).toNat ≤ (top - lo).toNat` and
`∀ i < 8, ¬ OnStack lo top (tlvDesc + i)`. -/
macro "frame_enter" L:ident lo:term:max top:term:max out:term:max k:term:max pc:term:max
    "as" s1:ident E:ident : tactic =>
  `(tactic| (refine Entered.run $L $lo $top $out $k $pc ?_ (fun $s1 $E => ?_)
             · m1_run until $pc
               refine SafeN.done (Entered.intro (by decide) (by assumption) (by assumption) (by assumption)
                 (by assumption) rfl rfl rfl ?_ ?_ ?_ rfl rfl ?_)
               · frame_regs $L
               · frame_regs $L
               · intro r hr; first | rfl | simp (disch := first | decide | assumption) only [upd_ge19]
               · frame_prologue_mem))

/-- `Frame.update` for the current goal's state `st`. -/
theorem Frame.update_goal {L : Layout} {lo top out : BitVec 64} {k : Nat} {s0 s st : State}
    {p : Program} {B : BitVec 64 → Prop} {n : Nat} {Q : State → Prop}
    (h : Frame L lo top out k s0 s) (hsp : st.sp = s.sp)
    (hg : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → slotOf L.gprs r = none → st.gpr r = s.gpr r)
    (hv : ∀ r : BitVec 5, 8 ≤ r.toNat → r.toNat ≤ 15 → slotOf L.vregs r = none →
      (st.vreg r).setWidth 64 = (s.vreg r).setWidth 64)
    (hf : st.fpcr = s.fpcr) (hm : MemW (Frame.W L lo top out k s0) s.mem st.mem)
    (cont : Frame L lo top out k s0 st → SafeN p B n st Q) : SafeN p B n st Q :=
  cont (h.update hsp hg hv hf hm)

/-- `Frame.update` for a state reached by stepping (registers checked per
register; the memory side condition is left as a goal). -/
macro "frame_update" F:term:max L:ident : tactic =>
  `(tactic| refine Frame.update $F (by (try frame_simp $L) <;> (try m1_simp_step) <;> done) (by frame_regs $L)
      (by frame_regs $L) rfl ?_)

/-- Move `F : Frame .. s0 s` to the goal's current state (a record reached by
stepping from `s`), as `F'`; the memory side condition is the first goal. -/
macro "frame_upd" F:term:max L:ident "as" F':ident : tactic =>
  `(tactic| refine Frame.update_goal $F (by (try frame_simp $L) <;> (try m1_simp_step) <;> done) (by frame_regs $L)
      (by frame_regs $L) rfl ?_ (fun $F' => ?_))

/-- Memory side conditions `MemW (Frame.W ..) m m'`: unchanged memory, or the
stores' ranges as goals. -/
macro "frame_mem" : tactic =>
  `(tactic| first
    | exact MemW.of_eq rfl
    | ((repeat (first
        | refine MemW.write64' _ ?_ ?_
        | refine MemW.write32' _ ?_ ?_
        | refine MemW.write16' _ ?_ ?_
        | refine MemW.write8' _ ?_ ?_
        | refine MemW.write128' _ ?_ ?_)); try exact MemW.refl _))

/-- Close a goal `SafeN p B n s' Q'` at a `ret`, where `Q'` is an `NPContract`
postcondition (`NPPost`), from `F : Frame L .. s0 s` (`s` the state at the
epilogue). The function's own postcondition is left as a goal. -/
macro "frame_ret" F:term:max L:ident : tactic =>
  `(tactic| (refine SafeN.done (Frame.ret_np $F ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_)
             ((try frame_simp $L) <;> (try m1_simp_step) <;> done)
             frame_regs $L
             frame_regs $L
             rfl
             rfl
             rfl
             rfl))

/-- Step the epilogue from a state `s` with `F : Frame L .. s0 s` (at the
epilogue's first instruction) through the `ret`, and close the goal
`SafeN p B n s (NPPost top out k post s0)`; `post s0 s'` is left as a goal
(`s'.mem = s.mem`: the epilogue changes no memory). -/
macro "frame_epi" F:term:max L:ident : tactic =>
  `(tactic| (have hsp_ := ($F).sp; have hal_ := ($F).al; frame_simp $L at hsp_
             m1_run
             frame_ret $F $L))

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1

/-- An 8-byte atomic at `a + 8` (an `Arc`'s weak count) with `a` 8-aligned does
not cross a 16-byte boundary (the condition `ldaddl` checks). -/
theorem atomic8_ok {a : BitVec 64} (h : a &&& (8#64 - 1#64) = 0#64) : ((a + 8#64) &&& 15#64).toNat ≤ 8 := by
  have : (a + 8#64) &&& 15#64 ≤ 8#64 := by bv_decide
  rw [BitVec.le_def] at this; simpa using this

/-- The same for the strong count at `a`. -/
theorem atomic0_ok {a : BitVec 64} (h : a &&& (8#64 - 1#64) = 0#64) : (a &&& 15#64).toNat ≤ 8 := by
  have : a &&& 15#64 ≤ 8#64 := by bv_decide
  rw [BitVec.le_def] at this; simpa using this

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

/-! ### The heap -/

/-- `k` bytes at `w`, inside the block `[b, b+nb)`. -/
theorem in_block {b nb w : BitVec 64} {k : Nat} (h : (w - b).toNat + k ≤ nb.toNat) :
    ∀ i < k, (w + BitVec.ofNat 64 i - b).toNat < nb.toNat := by
  intro i hi
  rw [show w + BitVec.ofNat 64 i - b = (w - b) + BitVec.ofNat 64 i by grind, BitVec.toNat_add,
    BitVec.toNat_ofNat]
  have := nb.isLt
  rw [Nat.mod_eq_of_lt (a := i) (by omega), Nat.mod_eq_of_lt (by omega)]
  omega

/-- Changes confined to a live block keep every other block live, with its
contents (`MemFacts.frame`, `MemFacts.disjoint`). -/
theorem HeapKept.of_block {H : Heap} {lo top : BitVec 64} (hM : MemFacts H lo top) {s s' : State}
    {P nP al : BitVec 64} (hl : H.Live s.mem P nP al)
    (h : MemW (fun x => (x - P).toNat < nP.toNat) s.mem s'.mem) : HeapKept H (· ≠ P) s s' := by
  intro b nb alb hb hlb
  refine ⟨hM.frame _ _ _ _ _ hlb fun x hx => Or.inr ⟨P, nP, al, hl, h x hx⟩, fun i hi => ?_⟩
  apply Classical.byContradiction; intro hc
  have hx := h _ hc
  exact (hM.disjoint _ _ _ _ _ _ _ hl hlb (Ne.symm hb)).offset (by omega) i hi hx

/-- A 64-bit store inside a live block. -/
theorem HeapKept.write64 {H : Heap} {lo top : BitVec 64} (hM : MemFacts H lo top) {s s' : State}
    {P nP al w v : BitVec 64} (hl : H.Live s.mem P nP al) (hw : (w - P).toNat + 8 ≤ nP.toNat)
    (hm : s'.mem = s.mem.write64 w v) : HeapKept H (· ≠ P) s s' :=
  HeapKept.of_block hM hl (hm ▸ MemW.write64 v (in_block hw))

/-- **Epilogue before a tail call**: the frame conditions at the jump, for the
current goal's state `st` (see `tail_np`). -/
theorem Frame.ret_goal {L : Layout} {lo top out : BitVec 64} {k : Nat} {s0 s st : State}
    {p : Program} {B : BitVec 64 → Prop} {n : Nat} {Q : State → Prop}
    (h : Frame L lo top out k s0 s) (hsp : st.sp = s0.sp)
    (hg : ∀ r : BitVec 5, 19 ≤ r.toNat → r.toNat ≤ 30 → st.gpr r = L.restoreG s0 s r)
    (hv : ∀ r : BitVec 5, 8 ≤ r.toNat → r.toNat ≤ 15 → (st.vreg r).setWidth 64 = L.restoreV s0 s r)
    (hf : st.fpcr = s.fpcr) (hm : st.mem = s.mem)
    (cont : CalleeSaved s0 st → st.gpr 30 = s0.gpr 30 → Keeps top out k s0 st →
      st.mem.read64 tlvDesc = s0.mem.read64 tlvDesc → SafeN p B n st Q) : SafeN p B n st Q :=
  let ⟨a, b, c, d⟩ := h.ret hsp hg hv hf hm
  cont a b c d

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic

/-- At a tail call (after stepping the epilogue and the `b`), from
`F : Frame L .. s0 s` (`s` the state at the epilogue): the frame conditions
of the jump state, named `hcs h30 hk htl` (for `tail_np`). -/
macro "frame_tail" F:term:max L:ident "as" hcs:ident h30:ident hk:ident htl:ident : tactic =>
  `(tactic| (refine Frame.ret_goal $F ?_ ?_ ?_ rfl rfl (fun $hcs $h30 $hk $htl => ?_)
             ((try frame_simp $L) <;> (try m1_simp_step) <;> done)
             frame_regs $L
             frame_regs $L))

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

/-- Writable bytes that are not off-stack heap bytes are on the stack. -/
theorem MemW.stackOnly' {A : BitVec 64 → Prop} {lo top : BitVec 64} {m m' : Memory} (h : MemW A m m')
    (hA : ∀ x, A x → OnStack lo top x) : StackOnly lo top m m' :=
  fun x hx => Classical.byContradiction fun hc => hx (hA x (h x hc))

/-- Stores into the declared output (in the callers' part of the stack) change only the stack. -/
theorem out_stackOnly {lo top sp out : BitVec 64} {n : Nat} {m m' : Memory}
    (hsp : (sp - lo).toNat ≤ (top - lo).toNat) (hout : (out - sp).toNat + n ≤ (top - sp).toNat)
    (h : MemW (fun x => (x - out).toNat < n) m m') : StackOnly lo top m m' :=
  h.stackOnly' fun x hx => by
    have := onStack_above hsp hout _ hx
    rwa [BitVec.ofNat_toNat, BitVec.setWidth_eq, BitVec.add_comm, BitVec.sub_add_cancel] at this

/-- `umulh a b = 0` iff the product does not overflow. -/
theorem umulh_eq_zero (a b : BitVec 64) :
    (a.setWidth 128 * b.setWidth 128).extractLsb' 64 64 = 0#64 ↔ a.toNat * b.toNat < 2 ^ 64 := by
  have ha := a.isLt; have hb := b.isLt
  have hab : a.toNat * b.toNat < 2 ^ 128 := by
    calc a.toNat * b.toNat < 2 ^ 64 * 2 ^ 64 := Nat.mul_lt_mul'' ha hb
      _ = 2 ^ 128 := by rfl
  constructor
  · intro h
    have := congrArg BitVec.toNat h
    simp only [BitVec.extractLsb'_toNat, BitVec.toNat_mul, BitVec.toNat_setWidth, BitVec.toNat_ofNat] at this
    rw [Nat.mod_eq_of_lt (a := a.toNat) (by omega), Nat.mod_eq_of_lt (a := b.toNat) (by omega),
      Nat.mod_eq_of_lt hab, Nat.shiftRight_eq_div_pow] at this
    have h2 : a.toNat * b.toNat / 2 ^ 64 < 2 ^ 64 := by
      rw [Nat.div_lt_iff_lt_mul (by decide)]; omega
    rw [Nat.mod_eq_of_lt h2] at this
    rw [Nat.div_eq_zero_iff] at this
    omega
  · intro h
    apply BitVec.eq_of_toNat_eq
    simp only [BitVec.extractLsb'_toNat, BitVec.toNat_mul, BitVec.toNat_setWidth, BitVec.toNat_ofNat]
    rw [Nat.mod_eq_of_lt (a := a.toNat) (by omega), Nat.mod_eq_of_lt (a := b.toNat) (by omega),
      Nat.mod_eq_of_lt hab, Nat.shiftRight_eq_div_pow, Nat.div_eq_of_lt h]

end Examples.Cedar.NoPanic

namespace Examples.Cedar.NoPanic
open M1 Examples.Cedar.Eval

/-- `k` bytes at `w`, inside `[b, b+n)`. -/
theorem in_range {b w : BitVec 64} {k n : Nat} (h : (w - b).toNat + k ≤ n) :
    ∀ i < k, (w + BitVec.ofNat 64 i - b).toNat < n := by
  intro i hi
  rw [show w + BitVec.ofNat 64 i - b = (w - b) + BitVec.ofNat 64 i by grind, BitVec.toNat_add,
    BitVec.toNat_ofNat]
  have := (w - b).isLt
  by_cases hn : n < 2 ^ 64
  · rw [Nat.mod_eq_of_lt (a := i) (by omega), Nat.mod_eq_of_lt (by omega)]; omega
  · have := Nat.mod_lt ((w - b).toNat + i % 2 ^ 64) (show 2 ^ 64 > 0 by decide); omega

/-- Stores into the declared output keep the heap. -/
theorem HeapKept.of_out {H : Heap} {lo top : BitVec 64} (hM : MemFacts H lo top) {k : BitVec 64 → Prop}
    {s0 s s' : State} {out : BitVec 64} {n : Nat} (hk : HeapKept H k s0 s)
    (hsp : (s0.sp - lo).toNat ≤ (top - lo).toNat) (hout : (out - s0.sp).toNat + n ≤ (top - s0.sp).toNat)
    (hm : MemW (fun x => (x - out).toNat < n) s.mem s'.mem) : HeapKept H k s0 s' :=
  hk.trans ((out_stackOnly hsp hout hm).heapKept hM k) fun _ h => h

/-- Memory side conditions for stores at `base + c` into a range `[base, base+n)`. -/
macro "mem_range" : tactic =>
  `(tactic| ((repeat (first
        | refine MemW.write64' _ ?_ (in_range (by simp [add_sub_self_left, sub_add_add_left]))
        | refine MemW.write32' _ ?_ (in_range (by simp [add_sub_self_left, sub_add_add_left]))
        | refine MemW.write16' _ ?_ (in_range (by simp [add_sub_self_left, sub_add_add_left]))
        | refine MemW.write8' _ ?_ (in_range (by simp [add_sub_self_left, sub_add_add_left]))
        | refine MemW.write64' _ ?_ (in_range (w := _ + 0#64) (by simp)))); exact MemW.refl _))

end Examples.Cedar.NoPanic

